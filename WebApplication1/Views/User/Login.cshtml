<h1 id="h10">Přihlášení</h1>

@{
    if (!string.IsNullOrEmpty(ViewData["chyba"]?.ToString()))
    {
        <span class="chyba">@ViewData["chyba"]</span>
    }
}

<form action="/User/Login" method="post" id="div4">
    <label for="fname">Username:</label><br>
    <input type="text" id="fname" name="fname" value=""><br>
    <label for="password">Heslo:</label><br>
    <input type="password" id="password" name="Heslo" value=""><br><br>
    <input type="submit" value="Přihlásit">
</form>